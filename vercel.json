{
  "cleanUrls": true,
  "trailingSlash": false,
  "buildCommand": "node build.js",
  "outputDirectory": "dist",
  "installCommand": "",
  "functions": {
    "api/topic-page.js": {
      "includeFiles": "dist/_topic-templates/**",
      "maxDuration": 10
    },
    "api/hub-page.js": {
      "includeFiles": "dist/*.html",
      "maxDuration": 15
    },
    "api/public-page.js": {
      "maxDuration": 15
    }
  },
  "redirects": [
    { "source": "/how-it-works", "destination": "/methodology", "permanent": true },
    { "source": "/learn", "destination": "/methodology", "permanent": true },
    { "source": "/discover", "destination": "/you", "permanent": true },
    { "source": "/discover/regulatory-status", "destination": "/regulatory", "permanent": true },
    { "source": "/discover/research-integrity", "destination": "/integrity", "permanent": true },
    { "source": "/interventions/:slug", "destination": "/topics/:slug", "permanent": true },
    { "source": "/discover/recruiting-trials", "destination": "/trials", "permanent": true },
    { "source": "/discover/recruiting-trials/:country", "destination": "/trials", "permanent": true },
    { "source": "/dashboard", "destination": "/topics", "permanent": true },
    { "source": "/leaderboard", "destination": "/universities", "permanent": true },
    { "source": "/join", "destination": "/topics", "permanent": true },
    { "source": "/invite/:code", "destination": "/topics", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options",    "value": "nosniff" },
        { "key": "X-Frame-Options",           "value": "DENY" },
        { "key": "X-XSS-Protection",          "value": "1; mode=block" },
        { "key": "Referrer-Policy",           "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",        "value": "camera=(), microphone=(), geolocation=()" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; style-src 'self' https://fonts.googleapis.com 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com; script-src 'self'; img-src 'self' data: https:; connect-src 'self' https://nifbuyoghesveotugday.supabase.co; frame-ancestors 'none';"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/linkedin-app-logo.png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/documents/:path*.pdf",
      "headers": [
        { "key": "Content-Type", "value": "application/pdf" },
        { "key": "Content-Disposition", "value": "inline" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet" },
        { "key": "Cache-Control", "value": "public, max-age=300, s-maxage=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/(style.css|main.js|intelligence.css|intelligence.js|institutional-pilot.css|institutional-pilot.js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, s-maxage=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/(topics-directory.json|resources-directory.json)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, s-maxage=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/:section(research|trials|regulatory|integrity)/:id",
      "headers": [
        { "key": "Content-Type", "value": "text/html; charset=utf-8" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; style-src 'self' https://fonts.googleapis.com 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https://nifbuyoghesveotugday.supabase.co; frame-ancestors 'none';" }
      ]
    },
    {
      "source": "/briefings/:path*",
      "headers": [
        { "key": "Content-Type", "value": "text/html; charset=utf-8" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; style-src 'self' https://fonts.googleapis.com 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https://nifbuyoghesveotugday.supabase.co; frame-ancestors 'none';" }
      ]
    },
    {
      "source": "/reports",
      "headers": [
        { "key": "Content-Type", "value": "text/html; charset=utf-8" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; style-src 'self' https://fonts.googleapis.com 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https://nifbuyoghesveotugday.supabase.co; frame-ancestors 'none';" }
      ]
    },
    {
      "source": "/changes",
      "headers": [
        { "key": "Content-Type", "value": "text/html; charset=utf-8" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; style-src 'self' https://fonts.googleapis.com 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com; script-src 'self'; img-src 'self' data: https:; connect-src 'self' https://nifbuyoghesveotugday.supabase.co; frame-ancestors 'none';" }
      ]
    },
    {
      "source": "/entities/:path*",
      "headers": [
        { "key": "Content-Type", "value": "text/html; charset=utf-8" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; style-src 'self' https://fonts.googleapis.com 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https://nifbuyoghesveotugday.supabase.co; frame-ancestors 'none';" }
      ]
    },
    {
      "source": "/universities/:path*",
      "headers": [
        { "key": "Content-Type", "value": "text/html; charset=utf-8" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; style-src 'self' https://fonts.googleapis.com 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com; script-src 'self'; img-src 'self' data: https:; connect-src 'self' https://nifbuyoghesveotugday.supabase.co; frame-ancestors 'none';" }
      ]
    },
    {
      "source": "/funders/:path*",
      "headers": [
        { "key": "Content-Type", "value": "text/html; charset=utf-8" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; style-src 'self' https://fonts.googleapis.com 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https://nifbuyoghesveotugday.supabase.co; frame-ancestors 'none';" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=60, s-maxage=300, stale-while-revalidate=3600, stale-if-error=86400" }
      ]
    },
    {
      "source": "/sitemaps/:path*",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=60, s-maxage=300, stale-while-revalidate=3600, stale-if-error=86400" }
      ]
    },
    {
      "source": "/feed.xml",
      "headers": [{ "key": "Content-Type", "value": "application/rss+xml; charset=utf-8" }]
    },
    {
      "source": "/feed.atom",
      "headers": [{ "key": "Content-Type", "value": "application/atom+xml; charset=utf-8" }]
    },
    {
      "source": "/feed.json",
      "headers": [{ "key": "Content-Type", "value": "application/feed+json; charset=utf-8" }]
    },
    {
      "source": "/feeds/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=300, s-maxage=900" }]
    },
    {
      "source": "/datasets/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=300, s-maxage=900" }]
    },
    {
      "source": "/api/subscribe",
      "headers": [
        { "key": "Content-Type", "value": "text/html; charset=utf-8" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/social-card/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800" }]
    }
  ],
  "rewrites": [
    { "source": "/topics/:slug", "destination": "/api/topic-page?slug=:slug" },
    { "source": "/research", "destination": "/api/hub-page?view=research" },
    { "source": "/trials", "destination": "/api/hub-page?view=trials" },
    { "source": "/universities", "destination": "/api/hub-page?view=universities" },
    { "source": "/funding", "destination": "/api/hub-page?view=funding" },
    { "source": "/auth/x", "destination": "/auth-x" },
    { "source": "/auth/linkedin", "destination": "/auth-linkedin" },
    { "source": "/compare/:pair", "destination": "/compare?pair=:pair" },
    { "source": "/trials/results-gap", "destination": "/trial-results-gap" },
    { "source": "/research/:id", "destination": "/api/public-page?mode=record&kind=research&id=:id" },
    { "source": "/trials/:id", "destination": "/api/public-page?mode=record&kind=trials&id=:id" },
    { "source": "/regulatory/:id", "destination": "/api/public-page?mode=record&kind=regulatory&id=:id" },
    { "source": "/integrity/:id", "destination": "/api/public-page?mode=record&kind=integrity&id=:id" },
    { "source": "/briefings", "destination": "/api/public-page?mode=briefings" },
    { "source": "/briefings/:slug", "destination": "/api/public-page?mode=briefings&slug=:slug" },
    { "source": "/changes", "destination": "/api/public-page?mode=changes" },
    { "source": "/changes/feed.xml", "destination": "/api/feed?format=rss" },
    { "source": "/changes/feed.json", "destination": "/api/feed?format=json" },
    { "source": "/reports", "destination": "/api/public-page?mode=reports" },
    { "source": "/api/subscribe", "destination": "https://nifbuyoghesveotugday.supabase.co/functions/v1/subscribe-briefing" },
    { "source": "/entities/:kind/:slug", "destination": "/api/public-page?mode=entity&kind=:kind&slug=:slug" },
    { "source": "/api/universities/:slug/works", "destination": "https://nifbuyoghesveotugday.supabase.co/functions/v1/public-pages?mode=university-works&slug=:slug" },
    { "source": "/universities/:slug", "destination": "/api/public-page?mode=university&slug=:slug" },
    { "source": "/funders", "destination": "/api/public-page?mode=funders" },
    { "source": "/funders/:slug", "destination": "/api/public-page?mode=funder&slug=:slug" },
    { "source": "/social-card/:kind/:key.png", "destination": "https://nifbuyoghesveotugday.supabase.co/functions/v1/social-card?kind=:kind&key=:key" },
    { "source": "/social-card/:kind/:key.svg", "destination": "https://nifbuyoghesveotugday.supabase.co/functions/v1/public-pages?mode=social&kind=:kind&key=:key" },
    { "source": "/api/intelligence/:kind/:id", "destination": "https://nifbuyoghesveotugday.supabase.co/functions/v1/public-pages?mode=api&kind=:kind&id=:id" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap?type=index" },
    { "source": "/sitemaps/research-:segment.xml", "destination": "/api/sitemap?type=research-:segment" },
    { "source": "/sitemaps/trials-:segment.xml", "destination": "/api/sitemap?type=trials-:segment" },
    { "source": "/sitemaps/regulatory-:segment.xml", "destination": "/api/sitemap?type=regulatory-:segment" },
    { "source": "/sitemaps/integrity-:segment.xml", "destination": "/api/sitemap?type=integrity-:segment" },
    { "source": "/sitemaps/research.xml", "destination": "/api/sitemap?type=research-0" },
    { "source": "/sitemaps/trials.xml", "destination": "/api/sitemap?type=trials-0" },
    { "source": "/sitemaps/regulatory.xml", "destination": "/api/sitemap?type=regulatory-0" },
    { "source": "/sitemaps/integrity.xml", "destination": "/api/sitemap?type=integrity-0" },
    { "source": "/sitemaps/briefings.xml", "destination": "/api/sitemap?type=briefings" },
    { "source": "/sitemaps/universities.xml", "destination": "/api/sitemap?type=universities" },
    { "source": "/sitemaps/entities.xml", "destination": "/api/sitemap?type=entities" },
    { "source": "/sitemaps/funders.xml", "destination": "/api/sitemap?type=funders" },
    { "source": "/sitemaps/topics.xml", "destination": "/api/sitemap?type=topics" },
    { "source": "/feed.xml", "destination": "/api/feed?format=rss" },
    { "source": "/feed.atom", "destination": "/api/feed?format=atom" },
    { "source": "/feed.json", "destination": "/api/feed?format=json" },
    { "source": "/feeds/topics/:topic.xml", "destination": "/api/feed?format=rss&topic=:topic" },
    { "source": "/feeds/topics/:topic.atom", "destination": "/api/feed?format=atom&topic=:topic" },
    { "source": "/feeds/topics/:topic.json", "destination": "/api/feed?format=json&topic=:topic" },
    { "source": "/datasets/:kind.csv", "destination": "https://nifbuyoghesveotugday.supabase.co/functions/v1/public-pages?mode=dataset&format=csv&kind=:kind" },
    { "source": "/datasets/:kind.json", "destination": "https://nifbuyoghesveotugday.supabase.co/functions/v1/public-pages?mode=dataset&format=json&kind=:kind" }
  ]
}
